    <Import Project="$(NuGetPackageRoot)microsoft.aspnetcore.components.webassembly.server\10.0.5\build\Microsoft.AspNetCore.Components.WebAssembly.Server.targets" Condition="Exists('$(NuGetPackageRoot)microsoft.aspnetcore.components.webassembly.server\10.0.5\build\Microsoft.AspNetCore.Components.WebAssembly.Server.targets')" />
